class_name PieceDB
extends RefCounted
## Independent database of 42 polyomino configurations (1-5 cells).
## Built from 15 base shapes; fixed orientations are generated by rotation
## (players cannot rotate pieces in the tray). Cell = Vector2i(x=col, y=row).

# [name, rows, weight, color_index]
const BASES := [
	["dot", ["#"], 3.0, 1],
	["domino", ["##"], 5.0, 2],
	["i3", ["###"], 5.0, 3],
	["l3", ["#.", "##"], 5.0, 4],
	["i4", ["####"], 3.0, 5],
	["o", ["##", "##"], 6.0, 6],
	["l4", ["#.", "#.", "##"], 4.0, 7],
	["j4", [".#", ".#", "##"], 4.0, 8],
	["t4", ["###", ".#."], 4.0, 1],
	["s4", [".##", "##."], 3.0, 2],
	["z4", ["##.", ".##"], 3.0, 3],
	["i5", ["#####"], 1.5, 4],
	["bigl5", ["#..", "#..", "###"], 2.5, 5],
	["u5", ["#.#", "###"], 2.0, 6],
	["t5", ["###", ".#.", ".#."], 2.0, 7],
]

static var _cache: Array = []
static var _by_id: Dictionary = {}

static func all() -> Array:
	if _cache.is_empty():
		_build()
	return _cache

static func get_piece(id: String) -> Dictionary:
	all()
	return _by_id.get(id, {})

static func count() -> int:
	return all().size()

static func _parse(rows: Array) -> Array:
	var cells: Array = []
	for r in rows.size():
		for c in rows[r].length():
			if rows[r][c] == "#":
				cells.append(Vector2i(c, r))
	return cells

static func normalize(cells: Array) -> Array:
	var minx := 1 << 30
	var miny := 1 << 30
	for p in cells:
		minx = mini(minx, p.x)
		miny = mini(miny, p.y)
	var out: Array = []
	for p in cells:
		out.append(Vector2i(p.x - minx, p.y - miny))
	out.sort_custom(func(a, b): return a.y < b.y or (a.y == b.y and a.x < b.x))
	return out

static func rotate90(cells: Array) -> Array:
	var out: Array = []
	for p in cells:
		out.append(Vector2i(-p.y, p.x))
	return normalize(out)

static func _key(cells: Array) -> String:
	var s := ""
	for p in cells:
		s += "%d,%d;" % [p.x, p.y]
	return s

static func _build() -> void:
	_cache.clear()
	_by_id.clear()
	for b in BASES:
		var cells := normalize(_parse(b[1]))
		var seen := {}
		var idx := 0
		for _i in 4:
			var k := _key(cells)
			if not seen.has(k):
				seen[k] = true
				var w := 0
				var h := 0
				for p in cells:
					w = maxi(w, p.x + 1)
					h = maxi(h, p.y + 1)
				var piece := {
					"id": "%s_%d" % [b[0], idx], "family": b[0], "cells": cells.duplicate(),
					"w": w, "h": h, "size": cells.size(), "weight": float(b[2]), "color": int(b[3]),
				}
				_cache.append(piece)
				_by_id[piece.id] = piece
				idx += 1
			cells = rotate90(cells)

## Returns "" if every piece is valid, otherwise a description of the problem.
static func validate_all() -> String:
	var ids := {}
	for p in all():
		if ids.has(p.id): return "duplicate id " + p.id
		ids[p.id] = true
		if p.size < 1 or p.size > 5: return "bad size " + p.id
		if p.w > 5 or p.h > 5: return "bad extent " + p.id
		for c in p.cells:
			if c.x < 0 or c.y < 0 or c.x >= p.w or c.y >= p.h: return "cell out of bounds " + p.id
	return ""
